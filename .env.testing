APP_NAME=Eventplaner
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_test
DB_USERNAME=laravel
DB_PASSWORD=secret

BCRYPT_ROUNDS=4

CACHE_STORE=array
QUEUE_CONNECTION=sync
# SESSION_DRIVER is intentionally NOT pinned here.
# - Pest/Unit/Feature tests override it via phpunit.xml (<env name="SESSION_DRIVER" value="array"/>).
# - The E2E workflow boots `php artisan serve` under APP_ENV=testing, so Laravel loads
#   THIS file (not .env). Pinning `array` here breaks CSRF: sessions vanish between
#   GET /login and POST /login, so every login POST comes back as 419 Page Expired.
# Falling through to config/session.php's default (`database`) keeps E2E working
# while phpunit.xml still gets `array` for the fast unit path.
MAIL_MAILER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
