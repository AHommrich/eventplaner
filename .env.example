APP_NAME=Eventplaner
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Local dev leaves this false so DB session rows stay human-readable while debugging.
# staging + production override this to `true` via Coolify env vars — session payload
# (auth context, active_event_id, CSRF token) is stored in the DB, so encryption
# prevents a DB leak from being an immediate session-hijack leak.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (für staging/production)
RESEND_API_KEY=

# Object Storage — Hetzner (S3-compatible API, primary bucket in Nürnberg).
# Migration from Cloudflare R2 completed 2026-07-01, see docs/legal/hetzner-object-storage-migration.md
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=nbg1
AWS_BUCKET=eveplan-photos-prod
AWS_ENDPOINT=https://nbg1.your-objectstorage.com
AWS_URL=https://eveplan-photos-prod.nbg1.your-objectstorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cross-region photo backup — Hetzner Object Storage, Helsinki (`hel1`).
# OPTIONAL: the scheduled job is gated on AWS_BACKUP_BUCKET being set, so
# leaving these empty is safe — the weekly hel1 backup simply doesn't run.
# To activate: create the bucket + a separate access-key (only PutObject +
# ListBucket on that bucket, NOT on the primary), set all AWS_BACKUP_* vars
# in Coolify (staging first, then production), then update the location
# entry in docs/legal/sub-processors.md in the SAME commit as the env-var
# change (governance rule, see CLAUDE.md).
AWS_BACKUP_ACCESS_KEY_ID=
AWS_BACKUP_SECRET_ACCESS_KEY=
AWS_BACKUP_DEFAULT_REGION=hel1
AWS_BACKUP_BUCKET=
AWS_BACKUP_ENDPOINT=https://hel1.your-objectstorage.com
AWS_BACKUP_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sentry — Error monitoring (EU region, Frankfurt).
# Leave DSNs empty in dev; set them via Coolify env vars for staging + production only.
# Sample rates deliberately low to stay inside the free-tier trace budget (10k/month).
# See docs/legal/sub-processors.md for the DPA reference.
#
# Two Sentry projects share the same organisation:
#   - Laravel backend (SENTRY_LARAVEL_DSN)
#   - Vue web frontend (VITE_SENTRY_DSN — must start with VITE_ so it lands in the client bundle)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_LOG_LEVEL=warning
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# Explicit environment tag for Sentry frontend (Vite bakes this into the bundle).
# Set to "staging" or "production" via Coolify per application — otherwise
# Vite defaults to `MODE=production` for every `npm run build`, and the
# Sentry dashboard shows all events tagged `production` even on beta.
VITE_SENTRY_ENVIRONMENT=
